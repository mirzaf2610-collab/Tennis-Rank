generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  pending
  confirmed
  disputed
  expired
}

model Player {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  unitKerja      String?  @map("unit_kerja")
  currentRating  Decimal  @default(1500.00) @map("current_rating") @db.Decimal(7, 2)
  matchesPlayed  Int      @default(0) @map("matches_played")
  isProvisional  Boolean  @default(true) @map("is_provisional")

  doublesRating         Decimal @default(1500.00) @map("doubles_rating") @db.Decimal(7, 2)
  doublesMatchesPlayed  Int     @default(0) @map("doubles_matches_played")
  doublesIsProvisional  Boolean @default(true) @map("doubles_is_provisional")

  isActive       Boolean  @default(true) @map("is_active")
  photoUrl       String?  @map("photo_url")
  emailVerified  Boolean  @default(false) @map("email_verified")
  isApproved     Boolean  @default(false) @map("is_approved")
  isAdmin        Boolean  @default(false) @map("is_admin")
  isBanned       Boolean  @default(false) @map("is_banned")
  noResponseCount Int     @default(0) @map("no_response_count")
  isDummy        Boolean  @default(false) @map("is_dummy")
  pendingName    String?  @map("pending_name") // nama baru yang diajukan, nunggu approval admin
  createdAt      DateTime @default(now()) @map("created_at")

  matchesWon      Match[]        @relation("WinnerMatches")
  matchesLost     Match[]        @relation("LoserMatches")
  ratingHistory   RatingHistory[]
  matchesSubmitted Match[]       @relation("SubmittedMatches")

  doublesAsT1P1 DoublesMatch[] @relation("T1P1")
  doublesAsT1P2 DoublesMatch[] @relation("T1P2")
  doublesAsT2P1 DoublesMatch[] @relation("T2P1")
  doublesAsT2P2 DoublesMatch[] @relation("T2P2")
  doublesSubmitted DoublesMatch[] @relation("DoublesSubmitted")
  doublesRatingHistory DoublesRatingHistory[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pushSubscriptions PushSubscription[]
  seasonRecords SeasonRecord[]
  tournamentParticipationsP1 TournamentParticipant[] @relation("TournamentParticipantP1")
  tournamentParticipationsP2 TournamentParticipant[] @relation("TournamentParticipantP2")

  @@map("players")
}

model Match {
  id                  Int         @id @default(autoincrement())
  winnerId            Int         @map("winner_id")
  loserId             Int         @map("loser_id")
  loserGames          Int         @map("loser_games")
  targetGames         Int         @default(6) @map("target_games")

  ratingWinnerBefore  Decimal?    @map("rating_winner_before") @db.Decimal(7, 2)
  ratingLoserBefore   Decimal?    @map("rating_loser_before") @db.Decimal(7, 2)
  ratingWinnerAfter   Decimal?    @map("rating_winner_after") @db.Decimal(7, 2)
  ratingLoserAfter    Decimal?    @map("rating_loser_after") @db.Decimal(7, 2)

  kFactorWinner       Int?        @map("k_factor_winner")
  kFactorLoser        Int?        @map("k_factor_loser")
  marginMultiplier    Decimal?    @map("margin_multiplier") @db.Decimal(5, 3)

  matchDate           DateTime    @default(now()) @map("match_date")
  inputBy             Int         @map("input_by")

  confirmedByWinner   Boolean     @default(false) @map("confirmed_by_winner")
  confirmedByLoser    Boolean     @default(false) @map("confirmed_by_loser")
  status              MatchStatus @default(pending)
  rejectReason         String?    @map("reject_reason")

  createdAt           DateTime    @default(now()) @map("created_at")
  confirmedAt          DateTime?  @map("confirmed_at")

  winner    Player @relation("WinnerMatches", fields: [winnerId], references: [id])
  loser     Player @relation("LoserMatches", fields: [loserId], references: [id])
  submitter Player @relation("SubmittedMatches", fields: [inputBy], references: [id])
  ratingHistory RatingHistory[]
  tournamentMatch TournamentMatch? @relation("TournamentSingleMatch")

  @@map("matches")
}

model RatingHistory {
  id            Int      @id @default(autoincrement())
  playerId      Int      @map("player_id")
  matchId       Int      @map("match_id")
  ratingBefore  Decimal  @map("rating_before") @db.Decimal(7, 2)
  ratingAfter   Decimal  @map("rating_after") @db.Decimal(7, 2)
  recordedAt    DateTime @default(now()) @map("recorded_at")

  player Player @relation(fields: [playerId], references: [id])
  match  Match  @relation(fields: [matchId], references: [id])

  @@map("rating_history")
}

model DoublesMatch {
  id            Int      @id @default(autoincrement())

  team1Player1Id Int @map("team1_player1_id")
  team1Player2Id Int @map("team1_player2_id")
  team2Player1Id Int @map("team2_player1_id")
  team2Player2Id Int @map("team2_player2_id")

  winningTeam   Int      @map("winning_team") // 1 atau 2
  loserGames    Int      @map("loser_games")  // 0-5, format tetap first-to-6

  team1RatingBefore Decimal? @map("team1_rating_before") @db.Decimal(7, 2)
  team2RatingBefore Decimal? @map("team2_rating_before") @db.Decimal(7, 2)
  marginMultiplier  Decimal? @map("margin_multiplier") @db.Decimal(5, 3)

  t1p1RatingBefore Decimal? @map("t1p1_rating_before") @db.Decimal(7, 2)
  t1p1RatingAfter  Decimal? @map("t1p1_rating_after") @db.Decimal(7, 2)
  t1p2RatingBefore Decimal? @map("t1p2_rating_before") @db.Decimal(7, 2)
  t1p2RatingAfter  Decimal? @map("t1p2_rating_after") @db.Decimal(7, 2)
  t2p1RatingBefore Decimal? @map("t2p1_rating_before") @db.Decimal(7, 2)
  t2p1RatingAfter  Decimal? @map("t2p1_rating_after") @db.Decimal(7, 2)
  t2p2RatingBefore Decimal? @map("t2p2_rating_before") @db.Decimal(7, 2)
  t2p2RatingAfter  Decimal? @map("t2p2_rating_after") @db.Decimal(7, 2)

  matchDate     DateTime @default(now()) @map("match_date")
  inputBy       Int      @map("input_by")

  confirmedT1P1 Boolean  @default(false) @map("confirmed_t1p1")
  confirmedT1P2 Boolean  @default(false) @map("confirmed_t1p2")
  confirmedT2P1 Boolean  @default(false) @map("confirmed_t2p1")
  confirmedT2P2 Boolean  @default(false) @map("confirmed_t2p2")

  status        MatchStatus @default(pending)
  rejectReason  String?  @map("reject_reason")

  createdAt     DateTime @default(now()) @map("created_at")
  confirmedAt   DateTime? @map("confirmed_at")

  team1Player1 Player @relation("T1P1", fields: [team1Player1Id], references: [id])
  team1Player2 Player @relation("T1P2", fields: [team1Player2Id], references: [id])
  team2Player1 Player @relation("T2P1", fields: [team2Player1Id], references: [id])
  team2Player2 Player @relation("T2P2", fields: [team2Player2Id], references: [id])
  submitter    Player @relation("DoublesSubmitted", fields: [inputBy], references: [id])

  ratingHistory DoublesRatingHistory[]
  tournamentMatch TournamentMatch? @relation("TournamentDoublesMatch")

  @@map("doubles_matches")
}

model DoublesRatingHistory {
  id            Int      @id @default(autoincrement())
  playerId      Int      @map("player_id")
  matchId       Int      @map("match_id")
  ratingBefore  Decimal  @map("rating_before") @db.Decimal(7, 2)
  ratingAfter   Decimal  @map("rating_after") @db.Decimal(7, 2)
  recordedAt    DateTime @default(now()) @map("recorded_at")

  player Player       @relation(fields: [playerId], references: [id])
  match  DoublesMatch @relation(fields: [matchId], references: [id])

  @@map("doubles_rating_history")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("email_verification_tokens")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("push_subscriptions")
}

model Season {
  id        Int       @id @default(autoincrement())
  name      String
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  records SeasonRecord[]

  @@map("seasons")
}

// Snapshot arsip rating & statistik tiap pemain saat 1 season berakhir.
// Data ini permanen, tidak berubah lagi setelah dicatat -- beda dengan rating
// "aktif" di tabel players yang terus berubah tiap ada match baru.
model SeasonRecord {
  id     Int @id @default(autoincrement())
  seasonId Int @map("season_id")
  playerId Int @map("player_id")

  playerName String @map("player_name") // disimpan juga di sini, jaga-jaga kalau nama pemain berubah nanti

  singlesRating        Decimal @map("singles_rating") @db.Decimal(7, 2)
  singlesMatchesPlayed Int     @map("singles_matches_played")
  singlesWins          Int     @map("singles_wins")
  singlesLosses        Int     @map("singles_losses")

  doublesRating        Decimal @map("doubles_rating") @db.Decimal(7, 2)
  doublesMatchesPlayed Int     @map("doubles_matches_played")
  doublesWins          Int     @map("doubles_wins")
  doublesLosses        Int     @map("doubles_losses")

  createdAt DateTime @default(now()) @map("created_at")

  season Season @relation(fields: [seasonId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([seasonId, playerId])
  @@map("season_records")
}

model Tournament {
  id          Int       @id @default(autoincrement())
  name        String
  format      String    // "round_robin" | "bracket"
  type        String    @default("singles") // "singles" | "doubles"
  status      String    @default("ongoing") // ongoing | completed
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  participants TournamentParticipant[]
  matches      TournamentMatch[]

  @@map("tournaments")
}

// 1 "peserta" turnamen = 1 pemain (Single) ATAU 1 tim berisi 2 pemain (Ganda, player2Id terisi)
model TournamentParticipant {
  id           Int  @id @default(autoincrement())
  tournamentId Int  @map("tournament_id")
  player1Id    Int  @map("player1_id")
  player2Id    Int? @map("player2_id") // cuma terisi untuk turnamen Ganda
  seed         Int  // urutan posisi/seeding yang diatur admin
  groupNumber  Int? @map("group_number") // cuma terisi untuk format group_knockout

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player1    Player     @relation("TournamentParticipantP1", fields: [player1Id], references: [id])
  player2    Player?    @relation("TournamentParticipantP2", fields: [player2Id], references: [id])

  matchesAsParticipant1 TournamentMatch[] @relation("TMParticipant1")
  matchesAsParticipant2 TournamentMatch[] @relation("TMParticipant2")
  matchesAsParticipant1b TournamentMatch[] @relation("TMParticipant1b")
  matchesAsParticipant2b TournamentMatch[] @relation("TMParticipant2b")
  matchesWon            TournamentMatch[] @relation("TMWinnerParticipant")

  @@map("tournament_participants")
}

model TournamentMatch {
  id                  Int      @id @default(autoincrement())
  tournamentId        Int      @map("tournament_id")
  stage               String   @default("main") // "main" (format biasa) | "group" | "knockout" (buat group_knockout)
  groupNumber         Int?     @map("group_number") // cuma terisi kalau stage="group"
  round               Int      @default(1)
  matchIndex          Int      @map("match_index")
  participant1Id      Int?     @map("participant1_id")
  participant2Id      Int?     @map("participant2_id")
  participant1bId     Int?     @map("participant1b_id") // partner sisi 1, cuma dipakai format Americano
  participant2bId     Int?     @map("participant2b_id") // partner sisi 2, cuma dipakai format Americano
  winnerParticipantId Int?     @map("winner_participant_id")
  singleMatchId        Int?    @unique @map("single_match_id")
  doublesMatchId       Int?    @unique @map("doubles_match_id")
  status              String   @default("pending") // pending | bye | completed
  createdAt           DateTime @default(now()) @map("created_at")

  tournament        Tournament             @relation(fields: [tournamentId], references: [id])
  participant1      TournamentParticipant? @relation("TMParticipant1", fields: [participant1Id], references: [id])
  participant2      TournamentParticipant? @relation("TMParticipant2", fields: [participant2Id], references: [id])
  participant1b     TournamentParticipant? @relation("TMParticipant1b", fields: [participant1bId], references: [id])
  participant2b     TournamentParticipant? @relation("TMParticipant2b", fields: [participant2bId], references: [id])
  winnerParticipant TournamentParticipant? @relation("TMWinnerParticipant", fields: [winnerParticipantId], references: [id])
  singleMatch       Match?                 @relation("TournamentSingleMatch", fields: [singleMatchId], references: [id])
  doublesMatch      DoublesMatch?          @relation("TournamentDoublesMatch", fields: [doublesMatchId], references: [id])

  @@map("tournament_matches")
}
